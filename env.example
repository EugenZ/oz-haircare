# Booking ("Запись на встречу") configuration — all optional.
# Copy to `.env.local` (gitignored) or set these as Worker vars/secrets.
# Without them the form still confirms locally; nothing is stored or emailed.

# --- Database (Postgres / Neon) ---
# Preferred: a full connection string.
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require
# Or the split form (port/db optional; defaults 5432 / neondb):
#   PGUSER=
#   PGPASSWORD=
#   PGHOST=
#   PGPORT=5432
#   PGDATABASE=neondb
# Apply the schema:  npm run db:generate   then   npx drizzle-kit push
# (`push` reads DATABASE_URL / PG* above; it creates the `bookings` table).

# --- Google Calendar: server-created event + attendee invite ---
# See docs/GOOGLE_CALENDAR_SETUP.md for the full OAuth setup. When set, a
# booking creates a real event on the practice's calendar and the client is added
# as an attendee (Google emails them the invite). Without them, the booking falls
# back to a Google Calendar "add to calendar" link + .ics (no OAuth needed).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# The same credentials above also power double-booking prevention:
# `GET /api/bookings/availability` + the POST guard both query this calendar
# via `events.list` so a client cannot pick a time Olya already has booked.

# --- Email backend (any REST API accepting { from, to, subject, html, text }) ---
# Default target: Resend. Set an API key to actually send; leave blank to skip.
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM=OZ SPA <booking@oz-spa.example>

# The practice's "meeting" mailbox — receives every new booking.
BOOKING_NOTIFY_EMAIL=

# Public site URL, included in client confirmation emails.
SITE_URL=
