# Booking ("Запись на встречу") configuration — all optional.
# Copy to `.env.local` (gitignored) or set these as Worker vars/secrets.
# Without them the form still accepts requests; nothing is stored or emailed.

# --- Database (Postgres / Neon) ---
# Required for the confirm / propose / outbox flow (requests are stored as
# `pending` until Olga confirms them).
# Preferred: a full connection string.
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require
# Or the split form (port/db optional; defaults 5432 / neondb):
#   PGUSER=
#   PGPASSWORD=
#   PGHOST=
#   PGPORT=5432
#   PGDATABASE=neondb
# Apply the schema:  npm run db:migrate  (reads DATABASE_URL / PG* above; runs
# on every deploy too — set DATABASE_URL as a Workers Builds build secret, see
# docs/DEPLOY.md). Never use `drizzle-kit push` against production.
#
# Integration tests (`npm run test:db`) run in a throwaway schema and drop it
# afterwards; they use TEST_DATABASE_URL, else DATABASE_URL above. A separate
# Neon branch for TEST_DATABASE_URL is the safest choice.
#   TEST_DATABASE_URL=
# Test-only, set by the tests themselves — never in production:
#   DATABASE_SCHEMA=

# --- Google Calendar: event created when Olga confirms a booking ---
# See docs/GOOGLE_CALENDAR_SETUP.md for the full OAuth setup. The same
# credentials power double-booking prevention: `GET /api/bookings/availability`
# and the server checks query this calendar via `events.list`.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# true = also add the client as an event attendee (Google emails its own invite,
# in addition to ours). Default: false.
GOOGLE_INVITE_ATTENDEE=false

# --- Email backend (Resend JSON API by default) ---
# Body: { from, to, subject, html, text, attachments: [{ filename, content(base64) }] }.
# Set an API key to actually send; leave blank to skip.
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM=OZ SPA <booking@oz-spa.example>

# The practice's "meeting" mailbox — receives every new request with the
# confirm / decline / propose link, and the client's answers to proposals.
BOOKING_NOTIFY_EMAIL=

# Optional: technical alerts (e.g. a request that could not be saved) with the
# error code/message, for whoever maintains the site. Olga still gets the client
# details and one-tap contact links either way.
ADMIN_ALERT_EMAIL=

# Public site URL used in email / SMS / Instagram links (no trailing slash).
# Falls back to the request origin when unset.
SITE_URL=

# --- Booking rules ---
# How long the client has to accept a proposed time (hours). Default: 48.
BOOKING_PROPOSAL_TTL_HOURS=48
# Country for phone numbers written without "+": US (default), CA or RU.
DEFAULT_PHONE_COUNTRY=US

# --- API tokens (long random strings, e.g. `openssl rand -base64 32`) ---
# GET /api/bookings (admin inbox): Authorization: Bearer <ADMIN_API_TOKEN>.
ADMIN_API_TOKEN=
# Apple Shortcuts («Команды») on Olga's iPhone: POST /api/outbox/claim + /api/outbox/:id/ack
# (Authorization: Bearer <OUTBOX_API_TOKEN>; see docs/IPHONE_SHORTCUTS.md).
OUTBOX_API_TOKEN=
